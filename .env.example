# Local synthetic-data mode. Production fails closed without identity and storage setup.
NODE_ENV=development
DEMO_MODE=true
HOST=127.0.0.1
PORT=4173
APP_ORIGIN=http://127.0.0.1:4173
DATA_DIRECTORY=./data
# Production: set DEMO_MODE=false, NODE_ENV=production and serve behind HTTPS.
# Clerk app keys: publishable key is public; secret key stays on the server.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional PEM JWT public key for networkless signature checks. Active session/user
# status is still checked through Clerk's Backend API on each human request.
CLERK_JWT_KEY=
# Require a second factor verified within this many minutes (5-60).
CLERK_MFA_MAX_AGE_MINUTES=15
# Production identity-provider contract/instance review gate.
CLERK_BAA_CONFIRMED=false
# Required in live mode. SQLite is only for local synthetic development.
DATABASE_URL=
NEON_BAA_CONFIRMED=false
# Verified email address(es) of MSP administrators, comma separated.
MSP_ADMINS=
# B2 S3-compatible endpoint and an application key restricted to the storage bucket.
# Provider credentials are SERVER ONLY. Never add them to dist/ or browser settings.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_KEY_ID=
STORAGE_APPLICATION_KEY=
# Both must be true to allow production file operations after documented review.
PROVIDER_BAA_CONFIRMED=false
HOSTING_APPROVED_FOR_PHI=false

# Dedicated workspace storage: 32 random bytes, base64 encoded. Keep stable and
# backed up separately from the metadata DB. Required for connect/create modes.
STORAGE_CREDENTIAL_ENCRYPTION_KEY=
# Optional account-level provisioning key. Required only for automatic bucket
# creation; file transfers use encrypted per-bucket restricted credentials.
STORAGE_PROVISIONING_KEY_ID=
STORAGE_PROVISIONING_APPLICATION_KEY=

# Authenticated scheduled security maintenance and audit archival. Production only.
CRON_SECRET=
# Offline backup tool only. Keep this independent recovery key outside Vercel
# and separately from encrypted .svbackup bundles. Never commit it.
# RECOVERY_BACKUP_KEY=
# Offline owner/migration and isolated restore tools only:
# DATABASE_MIGRATION_URL=
# RESTORE_DATABASE_URL=
