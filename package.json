{
  "name": "streamlined-vault",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/index.mjs && node --check server/devices.mjs && node --check server/storage.mjs && node --check dist/app.js && node --check dist/demo.js",
    "test:agent": "python -m unittest discover -s agent/tests -v"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "jose": "^6.0.0"
  }
}
